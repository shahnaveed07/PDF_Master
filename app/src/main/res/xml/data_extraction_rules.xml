    <device-transfer>
        <exclude domain="file" path="imported_pdfs" />
        <exclude domain="file" path="output_pdfs" />
        <exclude domain="file" path="output_images" />
        <exclude domain="file" path="output_texts" />
        <exclude domain="file" path="managed_pdfs" />
    </device-transfer>
</data-extraction-rules>
